# Copier ce fichier en infra/.env et remplacer les valeurs avant de lancer docker-compose.
# infra/.env est gitignore — ne jamais committer de vrais secrets.
#
# Un seul mot de passe (OEI_PASSWORD) est réutilisé par tous les conteneurs locaux
# (Postgres, Keycloak, MinIO, Grafana, pgAdmin) pour simplifier le développement local.

OEI_USER=oei
OEI_PASSWORD=changeme

POSTGRES_DB=keycloak

# Mot de passe du rôle oei_app / base oei (utilisé par le backend Spring Boot)
OEI_APP_PASSWORD=changeme

MINIO_ROOT_USER=oei-minio-admin

# ── Observabilité (profile: obs) ──────────────────────────────────────────
# Email de connexion à pgAdmin (http://localhost:5050 — OEI_PASSWORD comme mdp)
PGADMIN_EMAIL=admin@oei.local

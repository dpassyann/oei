{
  "realm": "oei",
  "enabled": true,
  "displayName": "Ordre des Experts Informaticiens",
  "loginTheme": "oei",
  "accountTheme": "oei",
  "adminTheme": "oei",
  "emailTheme": "oei",
  "sslRequired": "external",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "verifyEmail": true,
  "loginWithEmailAllowed": true,
  "roles": {
    "realm": [
      {
        "name": "member",
        "description": "Membre de l'OEI (rôle de base, tous niveaux confondus). Toujours combiné à un rôle de niveau member-*."
      },
      {
        "name": "admin",
        "description": "Administrateur OEI habilité à valider les demandes d'adhésion et à modérer la plateforme."
      },
      {
        "name": "member-standard",
        "description": "Niveau d'adhésion Standard.",
        "composite": true,
        "composites": {
          "realm": [
            "member"
          ]
        }
      },
      {
        "name": "member-silver",
        "description": "Niveau d'adhésion Silver.",
        "composite": true,
        "composites": {
          "realm": [
            "member"
          ]
        }
      },
      {
        "name": "member-gold",
        "description": "Niveau d'adhésion Gold (obtenu directement ou via rattachement à un employeur partenaire vérifié).",
        "composite": true,
        "composites": {
          "realm": [
            "member"
          ]
        }
      },
      {
        "name": "member-founding",
        "description": "Membre fondateur de l'OEI.",
        "composite": true,
        "composites": {
          "realm": [
            "member"
          ]
        }
      },
      {
        "name": "member-honorary",
        "description": "Membre honoraire, distinction attribuée par l'OEI.",
        "composite": true,
        "composites": {
          "realm": [
            "member"
          ]
        }
      },
      {
        "name": "member-institutional-affiliate",
        "description": "Membre rattaché à une institution partenaire (statut d'affiliation actif, distinct du niveau d'adhésion personnel).",
        "composite": true,
        "composites": {
          "realm": [
            "member"
          ]
        }
      },
      {
        "name": "institution-owner",
        "description": "Propriétaire du compte institution : seul rôle habilité à transférer la propriété ou clôturer le compte."
      },
      {
        "name": "institution-admin",
        "description": "Administrateur institutionnel : gère les rôles internes, invitations et paramètres du compte."
      },
      {
        "name": "institution-hr",
        "description": "Responsable RH institutionnel : gère les affiliations d'employés et les avantages collaborateurs."
      },
      {
        "name": "institution-tech-lead",
        "description": "Responsable technique institutionnel : référent sur les sujets techniques et les groupes de travail."
      },
      {
        "name": "institution-comms",
        "description": "Responsable communication institutionnel : rédige et soumet les publications institutionnelles."
      },
      {
        "name": "institution-reader",
        "description": "Lecteur institutionnel : accès en lecture seule au dashboard et à la bibliothèque, sans droit d'action."
      },
      {
        "name": "institution-contributor",
        "description": "Contributeur institutionnel : peut proposer des publications et des contributions, sans droit de validation."
      },
      {
        "name": "institution-affiliation-validator",
        "description": "Validateur d'affiliation : seul rôle habilité à approuver/rejeter une demande d'affiliation de membre à l'institution."
      }
    ]
  },
  "clients": [
    {
      "clientId": "oei-frontend",
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:4300/*"
      ],
      "webOrigins": [
        "http://localhost:4300"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "institution-group-path",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "claim.name": "groups"
          }
        }
      ]
    }
  ],
  "groups": [
    {
      "name": "institutions",
      "path": "/institutions",
      "subGroups": [
        {
          "name": "demo-institution",
          "path": "/institutions/demo-institution",
          "attributes": {
            "institutionId": [
              "demo-institution"
            ],
            "isDemoData": [
              "true"
            ]
          },
          "realmRoles": [
            "institution-owner"
          ]
        }
      ]
    }
  ],
  "internationalizationEnabled": true,
  "supportedLocales": [
    "fr",
    "en",
    "es",
    "de",
    "it",
    "pt"
  ],
  "defaultLocale": "fr",
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "no-reply@oei.local",
    "fromDisplayName": "Ordre International des Experts",
    "auth": "false",
    "starttls": "false",
    "ssl": "false"
  },
  "requiredActions": [
    {
      "alias": "CONFIGURE_TOTP",
      "name": "Configure OTP",
      "providerId": "CONFIGURE_TOTP",
      "enabled": true,
      "defaultAction": false,
      "priority": 10,
      "config": {}
    },
    {
      "alias": "TERMS_AND_CONDITIONS",
      "name": "Terms and Conditions",
      "providerId": "TERMS_AND_CONDITIONS",
      "enabled": false,
      "defaultAction": false,
      "priority": 20,
      "config": {}
    },
    {
      "alias": "UPDATE_PASSWORD",
      "name": "Update Password",
      "providerId": "UPDATE_PASSWORD",
      "enabled": true,
      "defaultAction": false,
      "priority": 30,
      "config": {}
    },
    {
      "alias": "UPDATE_PROFILE",
      "name": "Update Profile",
      "providerId": "UPDATE_PROFILE",
      "enabled": true,
      "defaultAction": false,
      "priority": 40,
      "config": {}
    },
    {
      "alias": "VERIFY_EMAIL",
      "name": "Verify Email",
      "providerId": "VERIFY_EMAIL",
      "enabled": true,
      "defaultAction": true,
      "priority": 50,
      "config": {}
    },
    {
      "alias": "delete_account",

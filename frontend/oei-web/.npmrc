virtual-store-dir=node_modules/.pnpm
# The locally installed pnpm (11.x) ships a self-managed "switch to the pinned
# packageManager version" feature that is broken in this sandbox (missing binary
# under .pnpm-store/v11/links/@/pnpm/10.33.0/...). Disable it so `pnpm add`/`pnpm install`
# run with whichever pnpm is actually on PATH instead of failing outright.
manage-package-manager-versions=false

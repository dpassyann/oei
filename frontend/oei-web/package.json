{
  "name": "oei-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "copy:content": "node scripts/copy-content-assets.mjs",
    "start": "node scripts/copy-content-assets.mjs && ng serve --proxy-config proxy.conf.json",
    "start:e2e": "node scripts/copy-content-assets.mjs && ng serve --proxy-config proxy.conf.json --port 4320",
    "build": "node scripts/copy-content-assets.mjs && ng build",
    "watch": "node scripts/copy-content-assets.mjs && ng build --watch --configuration development",
    "test": "node scripts/copy-content-assets.mjs && NODE_OPTIONS=--no-experimental-webstorage ng test",
    "generate:api": "openapi-generator-cli generate",
    "e2e": "playwright test"
  },
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "angular-oauth2-oidc": "^22.0.2",
    "qrcode": "^1.5.4",
    "rxjs": "~7.8.0",
    "three": "^0.185.1",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.2",
    "@angular/cli": "^22.1.2",
    "@angular/compiler-cli": "^22.1.0",
    "@openapitools/openapi-generator-cli": "^2.40.1",
    "@playwright/test": "^1.62.1",
    "@types/qrcode": "^1.5.6",
    "@types/three": "^0.185.4",
    "jsdom": "^28.0.0",
    "pdfkit": "^0.19.1",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  },
  "pnpm": {
    "overrides": {
      "lmdb": "npm:is-odd@3.0.1"
    }
  }
}

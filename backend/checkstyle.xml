<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  OEI backend Checkstyle ruleset.

  Scope: applies to every module's main sources (test sources are excluded via the plugin's
  own configuration, not here — tests legitimately use different import shapes, e.g. static
  AssertJ/JUnit imports). Bound to the `validate` phase with failOnViolation=true (see root
  pom.xml), so a violation blocks the build before compilation even starts.

  Rules chosen deliberately for this DDD/hexagonal, contract-first codebase:
  - Import hygiene (order/no-star/no-unused): keeps the domain-shared/domain-core/
    infrastructure/application-web layering visible at a glance in every file's import block.
  - LineLength: generous (160) because many hexagonal port/adapter method signatures and
    record constructors legitimately run long; still a real, enforced ceiling.
  - MissingJavadocType: mandatory on every public/protected top-level type, but ONLY for
    domain-shared/domain-core (see checkstyle-suppressions.xml) — the domain is this
    project's most important, most-reviewed code, per the project owner's own priority.
  - Naming/architecture conventions (no *Impl, adapter/service/resource package names, no
    *Resource duplicated per generated interface, etc.) are intentionally NOT duplicated
    here: ArchUnit (test/architecture) already enforces those at the type-dependency level,
    which Checkstyle (a per-file, syntax-level tool) cannot express as precisely.
-->
<module name="Checker">
    <property name="severity" value="error"/>
    <property name="fileExtensions" value="java"/>

    <module name="SuppressionFilter">
        <property name="file" value="${config_loc}/checkstyle-suppressions.xml"/>
        <property name="optional" value="true"/>
    </module>

    <module name="LineLength">
        <property name="max" value="160"/>
        <property name="ignorePattern" value="^import\s.*$|^\s*\*\s.*$"/>
    </module>

    <module name="TreeWalker">
        <!-- Import hygiene -->
        <module name="UnusedImports"/>
        <module name="AvoidStarImport"/>
        <module name="RedundantImport"/>
        <module name="ImportOrder">
            <property name="groups" value="java,jakarta,javax,org.springframework"/>
            <property name="ordered" value="true"/>
            <property name="separated" value="true"/>
            <property name="option" value="top"/>
            <property name="sortStaticImportsAlphabetically" value="true"/>
        </module>

        <!-- Javadoc on public types (domain-shared/domain-core only, see suppressions file) -->
        <module name="MissingJavadocType">
            <property name="scope" value="public"/>
        </module>

        <!-- General hygiene -->
        <module name="EmptyBlock">
            <property name="option" value="text"/>
        </module>
        <module name="EqualsHashCode"/>
        <module name="OneStatementPerLine"/>
    </module>
</module>

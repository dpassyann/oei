<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>global.oei</groupId>
    <artifactId>oei-backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../..</relativePath>
  </parent>

  <artifactId>test-acceptance</artifactId>
  <packaging>jar</packaging>
  <name>OEI Backend - Cucumber Acceptance Tests</name>
  <description>
    Business-facing Gherkin acceptance specifications (not UI/technical scenarios) for the
    key member journeys already implemented: membership consultation, certification
    declaration, wallet pass issuance (mocked), ethical charter signing, the CMS content
    publication workflow, and the professional-network anonymized salary insight (read
    against the real demo dataset -- there is no member-facing write path for individual
    compensation declarations in this iteration, see network-salary.feature's own comment).
    Boots the real application (application-web's OeiBackendApplication) against a real
    Testcontainers Postgres (never H2), exactly like production, with the real Liquibase
    changelog + demo data applied. Builds last in the reactor (depends, test scope, on
    application-web), same reason as test/architecture. Never deployed/published.
  </description>

  <properties>
    <maven.deploy.skip>true</maven.deploy.skip>
    <maven.install.skip>true</maven.install.skip>
  </properties>

  <dependencies>
    <dependency>
      <groupId>global.oei</groupId>
      <artifactId>domain-shared</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>global.oei</groupId>
      <artifactId>application-web</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- TestRestTemplate lives here (org.springframework.boot.resttestclient.TestRestTemplate) as of
         Spring Boot 4.1: it is no longer pulled in transitively by spring-boot-starter-test. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-resttestclient</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- TestRestTemplate's default constructor resolves a ClientHttpRequestFactoryBuilder and a
         RestTemplateBuilder from these two modules at runtime; neither is pulled in
         transitively by spring-boot-resttestclient. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-http-client</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-restclient</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>io.cucumber</groupId>
      <artifactId>cucumber-java</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.cucumber</groupId>
      <artifactId>cucumber-spring</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.cucumber</groupId>
      <artifactId>cucumber-junit-platform-engine</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-suite</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Stubs Stripe's PaymentIntents API locally for the "member buys a store product and
         pays by card" scenario: never a real (even sandbox) Stripe HTTP call from Cucumber,
         same posture/artifact as infrastructure-client's own adapter tests. -->
    <dependency>
      <groupId>org.wiremock</groupId>
      <artifactId>wiremock-standalone</artifactId>
      <version>${wiremock.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>

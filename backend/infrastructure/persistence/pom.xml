<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>global.oei</groupId>
    <artifactId>infrastructure</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>..</relativePath>
  </parent>

  <artifactId>infrastructure-persistence</artifactId>
  <packaging>jar</packaging>
  <name>OEI Backend - Infrastructure Persistence</name>
  <description>
    JPA + Liquibase persistence adapters. JPA entities are separate from the domain model;
    repositories/adapters map entity &lt;-&gt; domain at the boundary. Depends only on
    domain-shared, never on domain-core/application.
  </description>

  <dependencies>
    <dependency>
      <groupId>global.oei</groupId>
      <artifactId>domain-shared</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <!-- Used only to resolve the JPA auditing "current auditor" from the Authentication
         principal name (see PersistenceAuditingConfiguration); no security policy lives here. -->
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-core</artifactId>
    </dependency>
    <!--
      Spring Boot 4 moved Liquibase autoconfiguration out of spring-boot-autoconfigure into
      its own module: depending on liquibase-core alone (the previous state of this pom) is
      NOT enough to make SpringLiquibase auto-run on startup anymore, discovered by
      OeiWiringConfigurationTest (infrastructure-wiring) failing schema validation against a
      real, empty Testcontainers Postgres with "missing table [badge]": Liquibase was
      silently never running, in this module's own tests AND in the real application, this
      whole time. spring-boot-liquibase pulls liquibase-core transitively.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-liquibase</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Used only to (de)serialize ProfessionalProfile (a plain domain-shared record, no
         Jackson annotations needed) to/from the professional_profile.profile_json jsonb
         column, see ProfessionalProfilePersistenceAdapter. Not a REST/HTTP concern. -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.datatype</groupId>
      <artifactId>jackson-datatype-jsr310</artifactId>
    </dependency>

    <!-- Lombok: @RequiredArgsConstructor for constructor injection (never in domain-shared
         itself). Version managed by the inherited spring-boot-starter-parent BOM. -->
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Real Postgres for every persistence-adapter integration test (never H2, per the
         spring-boot-ddd-backend skill's conviction on this point). -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>

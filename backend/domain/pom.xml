<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>global.oei</groupId>
    <artifactId>oei-backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>..</relativePath>
  </parent>

  <artifactId>domain</artifactId>
  <packaging>pom</packaging>
  <name>OEI Backend - Domain</name>

  <modules>
    <module>shared</module>
    <module>core</module>
  </modules>

  <build>
    <plugins>
      <!--
        Maven-level guard for "domain stays framework-agnostic", inherited by domain-shared
        and domain-core: fails as early as `mvn validate`/`compile`, not just at test time.
        ArchUnit's DomainArchitectureTest (domain/core) covers the same intent at the
        bytecode level and is kept as a complementary, more precise check (it can also catch
        direct Spring/JPA source references even if a dependency is somehow on the classpath
        without being a declared Maven dependency).
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-no-spring-in-domain</id>
            <phase>validate</phase>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <searchTransitive>true</searchTransitive>
                  <excludes>
                    <exclude>org.springframework</exclude>
                    <exclude>org.springframework.boot</exclude>
                    <exclude>org.springframework.data</exclude>
                    <exclude>org.springframework.security</exclude>
                    <exclude>jakarta.persistence</exclude>
                  </excludes>
                </bannedDependencies>
              </rules>
              <fail>true</fail>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- JaCoCo: domain modules target 100% line/branch coverage (skill's coverage gate). -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>jacoco-prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>jacoco-report</id>
            <phase>test</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>

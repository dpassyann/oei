<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.0</version>
    <relativePath/>
  </parent>

  <groupId>global.oei</groupId>
  <artifactId>oei-backend</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>OEI Backend</name>
  <description>
    Backend Spring Boot de la plateforme OEI (Ordre des Experts Informaticiens).
    Architecture Maven multi-module DDD + Hexagonale : domain (shared/core),
    infrastructure (security/persistence), application (web/runtime).
  </description>

  <modules>
    <module>domain</module>
    <module>infrastructure</module>
    <module>application</module>
    <!-- Cross-module ArchUnit suite: depends (test scope) on every reactor artifact below,
         so it must build last. Not deployed (see its own pom for maven.deploy.skip). -->
    <module>test/architecture</module>
    <!-- Cucumber acceptance suite: boots the real application (test scope on
         application-web) against a real Testcontainers Postgres. Builds last for the same
         reason as test/architecture. Not deployed (see its own pom). -->
    <module>test/acceptance</module>
  </modules>

  <properties>
    <java.version>25</java.version>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!--
      Every non-Spring-Boot-managed third-party plugin/library version is centralized here.
      Child modules reference these properties (or the dependencyManagement entries below)
      only — never a hardcoded version. Lombok, JUnit, Mockito, and AssertJ versions come
      from the inherited spring-boot-starter-parent BOM and are deliberately NOT
      re-pinned here (the project inherits spring-boot-starter-parent directly, no
      intermediate custom parent, precisely so that BOM stays the single source of truth
      for Spring-Boot-managed dependencies).
    -->
    <archunit.version>1.5.0</archunit.version>
    <cucumber.version>7.31.0</cucumber.version>
    <maven-checkstyle-plugin.version>3.6.0</maven-checkstyle-plugin.version>
    <checkstyle.version>10.21.4</checkstyle.version>
    <openapi-generator.version>7.24.0</openapi-generator.version>
    <maven-assembly-plugin.version>3.8.0</maven-assembly-plugin.version>
    <build-helper-maven-plugin.version>3.6.1</build-helper-maven-plugin.version>
    <frontend-maven-plugin.version>2.0.2</frontend-maven-plugin.version>
    <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
    <jacoco-maven-plugin.version>0.8.15</jacoco-maven-plugin.version>
    <swagger-annotations-jakarta.version>2.2.52</swagger-annotations-jakarta.version>
    <jackson-databind-nullable.version>0.2.11</jackson-databind-nullable.version>
    <!-- infrastructure-client outbound HTTP stubbing only (never a real Stripe/PayPal call
         from any automated test). Pinned here instead of Spring-Boot-managed since Spring
         Boot's own BOM does not manage WireMock. -->
    <wiremock.version>3.13.2</wiremock.version>
    <!-- infrastructure-mail integration test only (never a real SMTP send from any
         automated test): in-memory test SMTP server. Not managed by the Spring Boot BOM. -->
    <greenmail.version>2.1.3</greenmail.version>
    <node.version>v22.14.0</node.version>
    <pnpm.version>10.33.0</pnpm.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- Internal modules -->
      <dependency>
        <groupId>global.oei</groupId>
        <artifactId>domain-shared</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>global.oei</groupId>
        <artifactId>domain-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>global.oei</groupId>
        <artifactId>infrastructure-security</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>global.oei</groupId>
        <artifactId>infrastructure-persistence</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>global.oei</groupId>
        <artifactId>infrastructure-client</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>global.oei</groupId>
        <artifactId>infrastructure-mail</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>global.oei</groupId>
        <artifactId>infrastructure-wiring</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>global.oei</groupId>
        <artifactId>application-web</artifactId>
        <version>${project.version}</version>
      </dependency>

      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit-junit5</artifactId>
        <version>${archunit.version}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>io.swagger.core.v3</groupId>
        <artifactId>swagger-annotations-jakarta</artifactId>
        <version>${swagger-annotations-jakarta.version}</version>
      </dependency>
      <dependency>
        <groupId>org.openapitools</groupId>
        <artifactId>jackson-databind-nullable</artifactId>
        <version>${jackson-databind-nullable.version}</version>
      </dependency>

      <!--
        Testcontainers BOM: the inherited spring-boot-starter-parent BOM only manages the
        "testcontainers.version" property (used below) and the org.springframework.boot
        "spring-boot-testcontainers" starter itself, not the underlying org.testcontainers:*
        artifacts (postgresql, junit-jupiter, ...) that every Testcontainers-backed
        integration/acceptance test in this project depends on directly. Imported here so
        those modules never need to pin a version themselves.
      -->
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>${testcontainers.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!-- Cucumber BOM: acceptance-only, see test/acceptance. -->
      <dependency>
        <groupId>io.cucumber</groupId>
        <artifactId>cucumber-bom</artifactId>
        <version>${cucumber.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <plugins>
      <!--
        Explicit annotationProcessorPaths for Lombok: relying on javac's automatic
        classpath discovery of annotation processors is fragile across compiler/toolchain
        configurations, so every module compiles with Lombok's processor declared
        explicitly here (inherited by all children; a no-op for modules that do not
        declare the lombok dependency itself, since annotationProcessorPaths only pulls in
        the processor jar, not a compile-time dependency).
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <annotationProcessorPaths>
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
              <version>${lombok.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>

    </plugins>

    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.openapitools</groupId>
          <artifactId>openapi-generator-maven-plugin</artifactId>
          <version>${openapi-generator.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-checkstyle-plugin</artifactId>
          <version>${maven-checkstyle-plugin.version}</version>
          <configuration>
            <configLocation>${maven.multiModuleProjectDirectory}/checkstyle.xml</configLocation>
            <suppressionsLocation>${maven.multiModuleProjectDirectory}/checkstyle-suppressions.xml</suppressionsLocation>
            <propertyExpansion>config_loc=${maven.multiModuleProjectDirectory}</propertyExpansion>
            <!-- Explicit, not the project.compileSourceRoots default: application-web adds
                 target/generated-sources (contract-first OpenAPI codegen output, never
                 hand-edited, not subject to this project's own style rules) as a compile
                 source root once its generate-sources phase runs. Pinning this to the real
                 hand-written source directory guarantees Checkstyle never scans generated
                 code, regardless of phase-ordering/incremental-build timing. -->
            <sourceDirectories>
              <sourceDirectory>${project.build.sourceDirectory}</sourceDirectory>
            </sourceDirectories>
            <includeTestSourceDirectory>false</includeTestSourceDirectory>
            <consoleOutput>true</consoleOutput>
            <failOnViolation>true</failOnViolation>
            <violationSeverity>warning</violationSeverity>
            <linkXRef>false</linkXRef>
          </configuration>
          <dependencies>
            <dependency>
              <groupId>com.puppycrawl.tools</groupId>
              <artifactId>checkstyle</artifactId>
              <version>${checkstyle.version}</version>
            </dependency>
          </dependencies>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-assembly-plugin</artifactId>
          <version>${maven-assembly-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>build-helper-maven-plugin</artifactId>
          <version>${build-helper-maven-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>com.github.eirslett</groupId>
          <artifactId>frontend-maven-plugin</artifactId>
          <version>${frontend-maven-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-enforcer-plugin</artifactId>
          <version>${maven-enforcer-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>${jacoco-maven-plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <profiles>
    <!--
      Checkstyle only runs in modules that actually have Java source to lint. Binding the
      execution unconditionally in <build><plugins> would also run it (and create a target/
      directory full of nothing but Checkstyle's own bookkeeping files) in every packaging=pom
      aggregator module (domain/, infrastructure/, application/ themselves have no
      src/main/java, only <modules> listings) — same problem/same fix as
      iap-apps-platform's root pom (activation on <exists>src/main/java</exists>).
    -->
    <profile>
      <id>checkstyle</id>
      <activation>
        <file>
          <exists>src/main/java</exists>
        </file>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-checkstyle-plugin</artifactId>
            <executions>
              <execution>
                <id>checkstyle-validate</id>
                <phase>validate</phase>
                <goals>
                  <goal>check</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>

<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.0</version>
    <relativePath/>
  </parent>

  <groupId>global.oei</groupId>
  <artifactId>oei-backend</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>OEI Backend</name>
  <description>
    Backend Spring Boot de la plateforme OEI (Ordre des Experts Informaticiens).
    Architecture Maven multi-module DDD + Hexagonale : domain (shared/core),
    infrastructure (security/persistence), application (web/runtime).
  </description>

  <modules>
    <module>domain</module>
    <module>infrastructure</module>
    <module>application</module>
  </modules>

  <properties>
    <java.version>25</java.version>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!-- Non Spring-Boot-managed plugin/library versions, centralized here -->
    <archunit.version>1.5.0</archunit.version>
    <openapi-generator.version>7.24.0</openapi-generator.version>
    <maven-assembly-plugin.version>3.8.0</maven-assembly-plugin.version>
    <build-helper-maven-plugin.version>3.6.1</build-helper-maven-plugin.version>
    <frontend-maven-plugin.version>2.0.2</frontend-maven-plugin.version>
    <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
    <node.version>v22.14.0</node.version>
    <pnpm.version>10.33.0</pnpm.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- Internal modules -->
      <dependency>
        <groupId>global.oei</groupId>
        <artifactId>domain-shared</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>global.oei</groupId>
        <artifactId>domain-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>global.oei</groupId>
        <artifactId>infrastructure-security</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>global.oei</groupId>
        <artifactId>infrastructure-persistence</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>global.oei</groupId>
        <artifactId>application-web</artifactId>
        <version>${project.version}</version>
      </dependency>

      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit-junit5</artifactId>
        <version>${archunit.version}</version>
        <scope>test</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.openapitools</groupId>
          <artifactId>openapi-generator-maven-plugin</artifactId>
          <version>${openapi-generator.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-assembly-plugin</artifactId>
          <version>${maven-assembly-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>build-helper-maven-plugin</artifactId>
          <version>${build-helper-maven-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>com.github.eirslett</groupId>
          <artifactId>frontend-maven-plugin</artifactId>
          <version>${frontend-maven-plugin.version}</version>
        </plugin>
        <!--
          TODO(architecture): Maven Enforcer rules for module dependency direction
          (e.g. banning domain -> infrastructure/application, or domain -> Spring)
          are not wired yet. ArchUnit (see domain/core) covers the same intent at
          the bytecode level in the meantime. Add an enforcer "banned dependencies"
          / custom rule execution here when the module graph grows and this needs
          a faster/earlier (dependency-graph-time) guard.
        -->
      </plugins>
    </pluginManagement>
  </build>
</project>

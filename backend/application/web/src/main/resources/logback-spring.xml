<?xml version="1.0" encoding="UTF-8"?>
<configuration>

  <!--
    OEI Backend — Logback configuration.

    Two profiles:
    • local  → human-readable coloured text (Spring Boot default pattern), suitable for
               reading directly in the IDE / terminal.
    • !local → structured JSON via logstash-logback-encoder, consumed by Docker Logging
               driver → Promtail → Loki.  Every MDC entry (correlationId, userId, …) is
               automatically serialised as a top-level JSON field.

    Inspired by the IAP platform's logback-iap-base.xml.
  -->

  <!-- ── Plain-text appender — local dev only ──────────────────────────────── -->
  <springProfile name="local">
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <appender name="CONSOLE_TEXT" class="ch.qos.logback.core.ConsoleAppender">
      <encoder>
        <pattern>%d{HH:mm:ss.SSS} %highlight(%-5level) [%cyan(%thread)] %yellow(%logger{36}) - %msg%replace(%magenta( [%mdc])){' \[\]', ''}%n</pattern>
      </encoder>
    </appender>
    <root level="INFO">
      <appender-ref ref="CONSOLE_TEXT"/>
    </root>
    <!-- Reduce noise from hibernate SQL in local -->
    <logger name="org.hibernate.SQL" level="WARN"/>
    <logger name="org.hibernate.orm.jdbc.bind" level="WARN"/>
  </springProfile>

  <!-- ── JSON appender — every non-local environment (Docker / CI / prod) ─── -->
  <springProfile name="!local">
    <appender name="CONSOLE_JSON" class="ch.qos.logback.core.ConsoleAppender">
      <encoder class="net.logstash.logback.encoder.LogstashEncoder">
        <!-- Fields expected by the Promtail pipeline_stages JSON parser:
             @level, @message, correlationId (from MDC). -->
        <customFields>{"service":"oei-backend"}</customFields>
        <!-- Include MDC as top-level JSON fields so Promtail can label on correlationId -->
        <includeMdcKeyName>correlationId</includeMdcKeyName>
        <includeMdcKeyName>userId</includeMdcKeyName>
      </encoder>
    </appender>
    <root level="INFO">
      <appender-ref ref="CONSOLE_JSON"/>
    </root>
    <logger name="org.hibernate.SQL" level="WARN"/>
    <logger name="org.hibernate.orm.jdbc.bind" level="WARN"/>
  </springProfile>

</configuration>


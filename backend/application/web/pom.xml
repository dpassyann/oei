<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.oei</groupId>
    <artifactId>application</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>..</relativePath>
  </parent>

  <artifactId>application-web</artifactId>
  <packaging>jar</packaging>
  <name>OEI Backend - Application Web</name>
  <description>
    Primary HTTP adapter AND composition root (deliberate choice — no separate
    application/runtime module, see the spring-boot-ddd-backend skill's "Composition root
    rule"): implements the server interfaces generated from the OEI OpenAPI contract
    (contract-first), carries @SpringBootApplication, and is therefore the only module
    allowed to depend on domain-core in addition to domain-shared and the infrastructure
    adapters. Also packages/publishes the OpenAPI contract as a zip + npm tgz for the
    Angular frontend.
  </description>

  <properties>
    <npm-package.name>oei-api-contract</npm-package.name>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.oei</groupId>
      <artifactId>domain-shared</artifactId>
    </dependency>
    <dependency>
      <groupId>org.oei</groupId>
      <artifactId>domain-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.oei</groupId>
      <artifactId>infrastructure-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.oei</groupId>
      <artifactId>infrastructure-persistence</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!-- Generated OpenAPI server interfaces/DTOs reference these annotation/type libraries. -->
    <dependency>
      <groupId>io.swagger.core.v3</groupId>
      <artifactId>swagger-annotations-jakarta</artifactId>
      <version>2.2.52</version>
    </dependency>
    <dependency>
      <groupId>org.openapitools</groupId>
      <artifactId>jackson-databind-nullable</artifactId>
      <version>0.2.11</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>

      <!-- Executable artifact: application-web is the composition root, no separate
           application/runtime module (see class-level Javadoc on OeiBackendApplication). -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <mainClass>org.oei.application.web.OeiBackendApplication</mainClass>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- OpenAPI Generator: server interfaces + DTOs only, contract-first. -->
      <plugin>
        <groupId>org.openapitools</groupId>
        <artifactId>openapi-generator-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>generate-oei-contract</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <inputSpec>${project.basedir}/src/main/resources/openapi/oei-api.yaml</inputSpec>
              <generatorName>spring</generatorName>
              <library>spring-boot</library>
              <apiPackage>org.oei.application.web</apiPackage>
              <invokerPackage>org.oei.application.web</invokerPackage>
              <modelPackage>org.oei.application.web.model</modelPackage>
              <output>${project.build.directory}/generated-sources</output>
              <modelNameSuffix>DTO</modelNameSuffix>
              <!-- Only the ApiUtil helper (used by the generated default interface methods
                   to emit example JSON responses) is needed; skip pom.xml/README/Application.java
                   and other Maven-project supporting files that would conflict with this module. -->
              <globalProperties>
                <supportingFiles>ApiUtil.java</supportingFiles>
              </globalProperties>
              <configOptions>
                <interfaceOnly>true</interfaceOnly>
                <useSpringBoot4>true</useSpringBoot4>
                <useTags>true</useTags>
                <useBeanValidation>true</useBeanValidation>
                <performBeanValidation>true</performBeanValidation>
                <dateLibrary>java8-localdatetime</dateLibrary>
                <serializableModel>true</serializableModel>
              </configOptions>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Package the OpenAPI contract as a distributable zip. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-assembly-plugin</artifactId>
        <configuration>
          <descriptors>
            <descriptor>${project.basedir}/src/main/resources/openapi-distribution.xml</descriptor>
          </descriptors>
        </configuration>
        <executions>
          <execution>
            <id>package-openapi-distribution</id>
            <phase>package</phase>
            <goals>
              <goal>single</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- Attach the OpenAPI zip as an extra Maven artifact (classifier api). The npm tgz
           (classifier npm) is attached only under the npm-contract profile below. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>attach-openapi-artifact</id>
            <phase>package</phase>
            <goals>
              <goal>attach-artifact</goal>
            </goals>
            <configuration>
              <artifacts>
                <artifact>
                  <file>${project.build.directory}/${project.artifactId}-${project.version}-openapi-distribution.zip</file>
                  <type>zip</type>
                  <classifier>api</classifier>
                </artifact>
              </artifacts>
            </configuration>
          </execution>
        </executions>
      </plugin>

    </plugins>

    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <excludes>
          <exclude>openapi/**</exclude>
        </excludes>
      </resource>
      <resource>
        <directory>src/main/resources/openapi</directory>
        <targetPath>openapi</targetPath>
        <excludes>
          <exclude>package.json</exclude>
        </excludes>
      </resource>
    </resources>
  </build>

  <profiles>
    <!--
      Opt-in profile: builds the @oei/api-contract npm tgz via Node/pnpm (frontend-maven-plugin)
      and attaches it as an extra Maven artifact (classifier npm), so the Angular frontend can
      later consume `pnpm add file:.../application-web-<version>-npm.tgz`. Not part of the
      default `mvn clean install` because it downloads/extracts a Node/pnpm toolchain, which is
      unnecessary for a Java-only CI build and not always possible in restricted sandboxes.
      Activate explicitly: `mvn -Pnpm-contract clean install`.
    -->
    <profile>
      <id>npm-contract</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-resources-plugin</artifactId>
            <executions>
              <execution>
                <id>filter-npm-package</id>
                <phase>process-resources</phase>
                <goals>
                  <goal>copy-resources</goal>
                </goals>
                <configuration>
                  <outputDirectory>${project.build.directory}/npm-package</outputDirectory>
                  <overwrite>true</overwrite>
                  <resources>
                    <resource>
                      <directory>src/main/resources/openapi</directory>
                      <filtering>true</filtering>
                    </resource>
                  </resources>
                </configuration>
              </execution>
            </executions>
          </plugin>

          <plugin>
            <groupId>com.github.eirslett</groupId>
            <artifactId>frontend-maven-plugin</artifactId>
            <configuration>
              <installDirectory>${project.build.directory}/node</installDirectory>
              <workingDirectory>${project.build.directory}/npm-package</workingDirectory>
            </configuration>
            <executions>
              <execution>
                <id>install-node-and-pnpm</id>
                <phase>generate-resources</phase>
                <goals>
                  <goal>install-node-and-pnpm</goal>
                </goals>
                <configuration>
                  <nodeVersion>${node.version}</nodeVersion>
                  <pnpmVersion>${pnpm.version}</pnpmVersion>
                </configuration>
              </execution>
              <execution>
                <id>pnpm-pack</id>
                <phase>package</phase>
                <goals>
                  <goal>pnpm</goal>
                </goals>
                <configuration>
                  <arguments>pack --pack-destination ${project.build.directory}</arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>

          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>build-helper-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>attach-npm-tgz</id>
                <phase>package</phase>
                <goals>
                  <goal>attach-artifact</goal>
                </goals>
                <configuration>
                  <artifacts>
                    <artifact>
                      <file>${project.build.directory}/${npm-package.name}-${project.version}.tgz</file>
                      <type>tgz</type>
                      <classifier>npm</classifier>
                    </artifact>
                  </artifacts>
                </configuration>
              </execution>
            </executions>
          </plugin>

          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-jar-plugin</artifactId>
            <configuration>
              <excludes>
                <exclude>node/**</exclude>
                <exclude>npm-package/**</exclude>
              </excludes>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>

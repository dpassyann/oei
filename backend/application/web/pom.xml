<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>global.oei</groupId>
    <artifactId>application</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>application-web</artifactId>
  <packaging>jar</packaging>
  <name>OEI Backend - Application Web</name>
  <description>
    Primary HTTP adapter. Implements the server interfaces generated from the OEI OpenAPI
    contract (contract-first) as explicit-Bean *Resource classes. Depends only on
    domain-shared (for port/use-case interfaces) and infrastructure (which transitively
    provides domain-core-backed beans via its wiring configuration) — never directly on
    domain-core; see infrastructure-wiring's OeiWiringConfiguration, the sole class in the
    project outside domain-core allowed to reference concrete domain-core types. Also
    carries the executable @SpringBootApplication (composition root: no separate
    application/runtime module) and packages/publishes the OpenAPI contract as a zip + npm
    tgz for the Angular frontend.
  </description>

  <properties>
    <npm-package.name>oei-api-contract</npm-package.name>
  </properties>

  <dependencies>
    <dependency>
      <groupId>global.oei</groupId>
      <artifactId>domain-shared</artifactId>
    </dependency>
    <dependency>
      <groupId>global.oei</groupId>
      <artifactId>infrastructure-wiring</artifactId>
    </dependency>
    <!-- domain-core is excluded from infrastructure-wiring's transitive closure (see
         application/pom.xml dependencyManagement) and reintroduced here at scope=runtime
         only: no class in this module may import a concrete domain-core type at compile
         time, but the classes must still be on the runtime classpath for
         OeiWiringConfiguration (infrastructure-wiring) to instantiate them when Spring
         actually starts. Scope comes from the parent's dependencyManagement — do not
         redeclare it here. -->
    <dependency>
      <groupId>global.oei</groupId>
      <artifactId>domain-core</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <!-- Expose /actuator/prometheus — scraped by Prometheus in the obs Docker profile.
         The MeterRegistry is autoconfigured by Spring Boot Actuator autoconfiguration. -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>

    <!-- Generated OpenAPI server interfaces/DTOs reference these annotation/type libraries.
         Versions managed centrally in the root pom's dependencyManagement. -->
    <dependency>
      <groupId>io.swagger.core.v3</groupId>
      <artifactId>swagger-annotations-jakarta</artifactId>
    </dependency>
    <dependency>
      <groupId>org.openapitools</groupId>
      <artifactId>jackson-databind-nullable</artifactId>
    </dependency>

    <!-- Lombok: @RequiredArgsConstructor for constructor injection in *Service/*Resource
         classes (never in domain-shared/domain-core, kept framework-agnostic). Version
         managed by the inherited spring-boot-starter-parent BOM. -->
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <scope>provided</scope>
    </dependency>

    <!-- JSON structured logs consumed by Promtail/Loki (logback-spring.xml profile !local). -->
    <dependency>
      <groupId>net.logstash.logback</groupId>
      <artifactId>logstash-logback-encoder</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- SecurityMockMvcRequestPostProcessors.jwt(): fabricates an authenticated JWT request
         directly in the SecurityContext, bypassing real token decoding, for @WebMvcTest
         slices against infrastructure-security's real JWT resource server filter chain. -->
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- @WebMvcTest: Spring Boot 4 moved this out of spring-boot-test-autoconfigure's
         "core" set into its own webmvc-test module (same reorganization as
         spring-boot-liquibase, see infrastructure-persistence's pom). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>

      <!-- Executable artifact: application-web is the composition root, no separate
           application/runtime module (see class-level Javadoc on OeiBackendApplication).
           classifier "exec" keeps the original thin JAR as the default artifact so
           downstream modules (test/architecture) can compile against it. -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <mainClass>global.oei.application.web.OeiBackendApplication</mainClass>
          <classifier>exec</classifier>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- OpenAPI Generator: server interfaces + DTOs only, contract-first. -->
      <plugin>
        <groupId>org.openapitools</groupId>
        <artifactId>openapi-generator-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>generate-oei-contract</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <inputSpec>${project.basedir}/src/main/resources/openapi/oei-api.yaml</inputSpec>
              <generatorName>spring</generatorName>
              <library>spring-boot</library>
              <apiPackage>global.oei.application.web</apiPackage>
              <invokerPackage>global.oei.application.web</invokerPackage>
              <modelPackage>global.oei.application.web.model</modelPackage>
              <output>${project.build.directory}/generated-sources</output>
              <modelNameSuffix>DTO</modelNameSuffix>
              <!-- Only the ApiUtil helper (used by the generated default interface methods
                   to emit example JSON responses) is needed; skip pom.xml/README/Application.java
                   and other Maven-project supporting files that would conflict with this module. -->
              <globalProperties>
                <supportingFiles>ApiUtil.java</supportingFiles>
              </globalProperties>
              <configOptions>
                <interfaceOnly>true</interfaceOnly>
                <useSpringBoot4>true</useSpringBoot4>
                <useTags>true</useTags>
                <useBeanValidation>true</useBeanValidation>
                <performBeanValidation>true</performBeanValidation>
                <dateLibrary>java8-localdatetime</dateLibrary>
                <serializableModel>true</serializableModel>
              </configOptions>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Package the OpenAPI contract as a distributable zip. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-assembly-plugin</artifactId>
        <configuration>
          <descriptors>
            <descriptor>${project.basedir}/src/main/resources/openapi-distribution.xml</descriptor>
          </descriptors>
        </configuration>
        <executions>
          <execution>
            <id>package-openapi-distribution</id>
            <phase>package</phase>
            <goals>
              <goal>single</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- Attach the OpenAPI zip as an extra Maven artifact (classifier api). The npm tgz
           (classifier npm) is attached only under the npm-contract profile below. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>attach-openapi-artifact</id>
            <phase>package</phase>
            <goals>
              <goal>attach-artifact</goal>
            </goals>
            <configuration>
              <artifacts>
                <artifact>
                  <file>${project.build.directory}/${project.artifactId}-${project.version}-openapi-distribution.zip</file>
                  <type>zip</type>
                  <classifier>api</classifier>
                </artifact>
              </artifacts>
            </configuration>
          </execution>
        </executions>
      </plugin>

    </plugins>

    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <excludes>
          <exclude>openapi/**</exclude>
        </excludes>
      </resource>
      <resource>
        <directory>src/main/resources/openapi</directory>
        <targetPath>openapi</targetPath>
        <excludes>
          <exclude>package.json</exclude>
        </excludes>
      </resource>
    </resources>
  </build>

  <profiles>
    <!--
      Opt-in profile: builds the @oei/api-contract npm tgz via Node/pnpm (frontend-maven-plugin)
      and attaches it as an extra Maven artifact (classifier npm), so the Angular frontend can
      later consume `pnpm add file:.../application-web-<version>-npm.tgz`. Not part of the
      default `mvn clean install` because it downloads/extracts a Node/pnpm toolchain, which is
      unnecessary for a Java-only CI build and not always possible in restricted sandboxes.
      Activate explicitly: `mvn -Pnpm-contract clean install`.
    -->
    <profile>
      <id>npm-contract</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-resources-plugin</artifactId>
            <executions>
              <execution>
                <id>filter-npm-package</id>
                <phase>process-resources</phase>
                <goals>
                  <goal>copy-resources</goal>
                </goals>
                <configuration>
                  <outputDirectory>${project.build.directory}/npm-package</outputDirectory>
                  <overwrite>true</overwrite>
                  <resources>
                    <resource>
                      <directory>src/main/resources/openapi</directory>
                      <filtering>true</filtering>
                    </resource>
                  </resources>
                </configuration>
              </execution>
            </executions>
          </plugin>

          <plugin>
            <groupId>com.github.eirslett</groupId>
            <artifactId>frontend-maven-plugin</artifactId>
            <configuration>
              <installDirectory>${project.build.directory}/node</installDirectory>
              <workingDirectory>${project.build.directory}/npm-package</workingDirectory>
            </configuration>
            <executions>
              <execution>
                <id>install-node-and-pnpm</id>
                <phase>generate-resources</phase>
                <goals>
                  <goal>install-node-and-pnpm</goal>
                </goals>
                <configuration>
                  <nodeVersion>${node.version}</nodeVersion>
                  <pnpmVersion>${pnpm.version}</pnpmVersion>
                </configuration>
              </execution>
              <execution>
                <id>pnpm-pack</id>
                <phase>package</phase>
                <goals>
                  <goal>pnpm</goal>
                </goals>
                <configuration>
                  <arguments>pack --pack-destination ${project.build.directory}</arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>

          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>build-helper-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>attach-npm-tgz</id>
                <phase>package</phase>
                <goals>
                  <goal>attach-artifact</goal>
                </goals>
                <configuration>
                  <artifacts>
                    <artifact>
                      <file>${project.build.directory}/${npm-package.name}-${project.version}.tgz</file>
                      <type>tgz</type>
                      <classifier>npm</classifier>
                    </artifact>
                  </artifacts>
                </configuration>
              </execution>
            </executions>
          </plugin>

          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-jar-plugin</artifactId>
            <configuration>
              <excludes>
                <exclude>node/**</exclude>
                <exclude>npm-package/**</exclude>
              </excludes>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>

# Logs & temp
*.log
logs/
tmp/

# Generated OpenAPI clients (regenerated from contracts)
frontend/**/src/**/infrastructure/clients/**/

# Large, read-only raw vendor OpenAPI specs used to cross-check the reduced, hand-authored
# infrastructure/client contracts against real field names — never committed (multi-MB each,
# and not this project's own artifact); see the header comments in
# backend/infrastructure/client/src/main/resources/openapi/{stripe,paypal}-api.yaml.
.prompt/deployment/vendor-openapi-raw/

# Production secrets/credentials that must never be committed
oei-prod-key.pem
.prompt/local/oei-prod-secrets.txt
.prompt/local/oei-prod.env
